{
  "name": "firestore-rules-builder",
  "version": "0.1.13",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "node --eval \"const fs = require('node:fs'); for (const path of ['dist', '.test-dist']) fs.rmSync(path, { recursive: true, force: true })\"",
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "tsc -p __tests__/tsconfig.json && node --test .test-dist/*.test.js",
    "prepack": "pnpm test"
  },
  "author": "betabites",
  "license": "ISC",
  "description": "A TypeScript builder for generating type-safe Cloud Firestore security rules.",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.3",
    "ajv-cli": "^5.0.0",
    "firebase": "^12.19.0",
    "typescript": "^7.0.2",
    "yamljs": "^0.3.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
